<%- include('header') %>
<div class="card shadow-sm mx-auto" style="max-width:650px"><div class="card-body p-4">
  <h2 class="mb-1">Оставить отзыв</h2>
  <p class="text-muted mb-4"><%= request.room_name %>, <%= fmtDate(request.date_start) %></p>
  <form method="post" action="/requests/<%= request.id %>/review">
    <div class="mb-3">
      <label class="form-label" for="rating">Оценка</label>
      <select class="form-select" id="rating" name="rating" required>
        <option value="">Выберите оценку</option>
        <% for (let i = 1; i <= 5; i++) { %>
          <option value="<%= i %>" <%= String(form.rating) === String(i) ? 'selected' : '' %>><%= i %></option>
        <% } %>
      </select>
    </div>
    <div class="mb-4">
      <label class="form-label" for="text">Комментарий</label>
      <textarea class="form-control" id="text" name="text" rows="4" required><%= form.text || '' %></textarea>
    </div>
    <button class="btn btn-primary">Отправить</button>
    <a class="btn btn-secondary" href="/dashboard">Отмена</a>
  </form>
</div></div>
<%- include('footer') %>

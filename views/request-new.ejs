<%- include('header') %>
<div class="card shadow-sm mx-auto" style="max-width:650px"><div class="card-body p-4">
  <h2 class="mb-4">Формирование заявки</h2>
  <form method="post" action="/requests">
    <div class="mb-3">
      <label class="form-label">ФИО</label>
      <input class="form-control" value="<%= user.fio %>" readonly>
    </div>
    <div class="mb-3">
      <label class="form-label" for="room_id">Помещение</label>
      <select class="form-select" id="room_id" name="room_id" required>
        <option value="">Выберите помещение</option>
        <% rooms.forEach(function (r) { %>
          <option value="<%= r.id %>" <%= String(form.room_id) === String(r.id) ? 'selected' : '' %>><%= r.name %> (до <%= r.capacity %> чел.)</option>
        <% }) %>
      </select>
    </div>
    <div class="mb-3">
      <label class="form-label" for="date_start">Дата конференции</label>
      <input class="form-control" type="date" id="date_start" name="date_start" value="<%= form.date_start || '' %>" required>
    </div>
    <div class="mb-4">
      <label class="form-label" for="payment">Способ оплаты</label>
      <select class="form-select" id="payment" name="payment" required>
        <option value="">Выберите способ оплаты</option>
        <% payments.forEach(function (p) { %>
          <option <%= form.payment === p ? 'selected' : '' %>><%= p %></option>
        <% }) %>
      </select>
    </div>
    <button class="btn btn-primary w-100">Отправить заявку</button>
  </form>
</div></div>
<%- include('footer') %>

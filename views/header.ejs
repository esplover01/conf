              <li class="nav-item"><a class="nav-link fw-bold text-danger" href="/admin">Админ-панель</a></li>
            <% } %>
            <li class="nav-item"><a class="nav-link" href="/dashboard">Мои заявки</a></li>
            <li class="nav-item"><a class="nav-link text-danger" href="/logout">Выход</a></li>
          <% } else { %>
            <li class="nav-item"><a class="nav-link" href="/register">Регистрация</a></li>
            <li class="nav-item"><a class="nav-link" href="/login">Вход</a></li>
          <% } %>
        </ul>
      </div>
    </nav>
    <div class="container mt-4 mb-5">

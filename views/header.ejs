<!DOCTYPE html>
<html lang="ru">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="stylesheet" href="/css/bootstrap.min.css">
    <link rel="stylesheet" href="/css/style.css">
    <link rel="icon" href="/img/1.ico">
    <title><%= typeof title !== 'undefined' ? title : 'Конференции.РФ' %></title>
  </head>
  <body>
    <nav class="navbar navbar-light bg-light">
  <div class="container-fluid">
    <span class="navbar-brand mb-0 h1">Конференция - РФ</span>
    <ul class="navbar-nav ms-auto flex-row gap-2">
      <li class="nav-item"><a class="nav-link" href="/rooms">Помещения</a></li>
      <% if (session && session.userId) { %>
        <li class="nav-item"><a class="nav-link" href="/dashboard">Мои заявки</a></li>
        <li class="nav-item"><a class="nav-link" href="/create">Новая заявка</a></li>
        <% if (session.role === 'admin') { %>
          <li class="nav-item"><a class="nav-link" href="/admin">Админ</a></li>
        <% } %>
        <li class="nav-item"><a class="nav-link" href="/logout">Выход (<%= session.fio %>)</a></li>
      <% } else { %>
        <li class="nav-item"><a class="nav-link" href="/register">Регистрация</a></li>
        <li class="nav-item"><a class="nav-link" href="/login">Вход</a></li>
      <% } %>
    </ul>
  </div>
</nav>
<div class="container mt-4 mb-5">

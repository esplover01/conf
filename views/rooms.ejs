<%- include('header') %>
<h2 class="mb-3">Список помещений</h2>
<div class="card shadow-sm"><div class="card-body"><div class="table-responsive">
  <table class="table table-hover mb-0">
    <thead><tr><th>Название</th><th>Тип</th><th>Вместимость</th></tr></thead>
    <tbody>
      <% rooms.forEach(function (r) { %>
        <tr><td><%= r.name %></td><td><%= r.type %></td><td><%= r.capacity %></td></tr>
      <% }) %>
    </tbody>
  </table>
</div></div></div>
<%- include('footer') %>

<%- include('header') %>

<div class="row justify-content-center">
  <div class="col-md-6 col-12">
    <div class="card">
      <div class="card-body">


        <% if (typeof flash !== 'undefined' && flash) { %>
          <div class="alert alert-<%= flash.type %>"><%= flash.text %></div>
        <% } %>

   
        <ul class="nav nav-tabs mb-3" role="tablist">
          <li class="nav-item" role="presentation">
            <button class="nav-link <%= mode === 'register' ? 'active' : '' %>"
                    data-bs-toggle="tab"
                    data-bs-target="#register-tab"
                    type="button"
                    role="tab">
              Регистрация
            </button>
          </li>
          <li class="nav-item" role="presentation">
            <button class="nav-link <%= mode === 'login' ? 'active' : '' %>"
                    data-bs-toggle="tab"
                    data-bs-target="#login-tab"
                    type="button"
                    role="tab">
              Вход
            </button>
          </li>
        </ul>


        <div class="tab-content">

 
          <div class="tab-pane fade <%= mode === 'register' ? 'show active' : '' %>"
               id="register-tab"
               role="tabpanel">

    
            <% if (mode === 'register' && typeof errors !== 'undefined' && errors && errors.length) { %>
              <div class="alert alert-danger">
                <ul class="mb-0">
                  <% errors.forEach(e => { %>
                    <li><%= e %></li>
                  <% }) %>
                </ul>
              </div>
            <% } %>

            <form method="POST" action="/register">
              <div class="mb-3">
                <label class="form-label">Логин</label>
                <input type="text" class="form-control" name="login"
                       value="<%= typeof form !== 'undefined' ? (form.login || '') : '' %>"
                       placeholder="латиница и цифры, минимум 6 символов" required>
              </div>

              <div class="mb-3">
                <label class="form-label">Пароль</label>
                <input type="password" class="form-control" name="password"
                       placeholder="минимум 8 символов" required>
              </div>

              <div class="mb-3">
                <label class="form-label">ФИО</label>
                <input type="text" class="form-control" name="fio"
                       value="<%= typeof form !== 'undefined' ? (form.fio || '') : '' %>"
                       placeholder="Иванов Иван Иванович" required>
              </div>

              <div class="mb-3">
                <label class="form-label">Телефон</label>
                <input type="text" class="form-control" name="phone"
                       value="<%= typeof form !== 'undefined' ? (form.phone || '') : '' %>"
                       placeholder="8(999)123-45-67" required>
              </div>

              <div class="mb-3">
                <label class="form-label">Email</label>
                <input type="email" class="form-control" name="email"
                       value="<%= typeof form !== 'undefined' ? (form.email || '') : '' %>"
                       placeholder="user@example.com" required>
              </div>

              <button type="submit" class="btn btn-primary w-100">Создать пользователя</button>
            </form>

            <p class="mt-3 text-center">
              Уже есть аккаунт?
              <button class="btn btn-link p-0" data-bs-toggle="tab" data-bs-target="#login-tab" type="button">
                Войти
              </button>
            </p>
          </div>

     
          <div class="tab-pane fade <%= mode === 'login' ? 'show active' : '' %>"
               id="login-tab"
               role="tabpanel">

      
            <% if (mode === 'login' && typeof error !== 'undefined' && error) { %>
              <div class="alert alert-danger"><%= error %></div>
            <% } %>

            <form method="POST" action="/login">
              <div class="mb-3">
                <label class="form-label">Логин</label>
                <input type="text" class="form-control" name="login" required>
              </div>

              <div class="mb-3">
                <label class="form-label">Пароль</label>
                <input type="password" class="form-control" name="password" required>
              </div>

              <button type="submit" class="btn btn-primary w-100">Войти</button>
            </form>

            <p class="mt-3 text-center">
              Еще не зарегистрированы?
              <button class="btn btn-link p-0" data-bs-toggle="tab" data-bs-target="#register-tab" type="button">
                Регистрация
              </button>
            </p>
          </div>

        </div>

      </div>
    </div>
  </div>
</div>

<%- include('footer') %>